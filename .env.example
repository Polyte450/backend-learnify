PORT=5000
DATABASE_URL=postgresql://postgres:password@localhost:5432/learnify
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173

# OAuth providers. Leave blank until each provider app is configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# USSD provider adapter (Africa's Talking or Twilio)
USSD_PROVIDER=africastalking
USSD_USERNAME=
USSD_API_KEY=
USSD_SERVICE_CODE=

# Email delivery. In development, links are logged when SMTP is blank.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@learnify.app
